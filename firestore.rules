rules_version = '2';
// AD WORLD security policy: verified owner admin plus authenticated, non-anonymous users.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function admin() {
      return signedIn()
        && request.auth.token.email == 'mgawish027@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/sellerProfiles/$(request.auth.uid))
          || get(/databases/$(database)/documents/sellerProfiles/$(request.auth.uid)).data.blocked != true);
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if activeUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if admin()
        || (activeUser()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'category', 'price', 'place', 'phone', 'desc', 'date', 'status', 'photos', 'photo', 'photoPaths'])
          && (!('status' in request.resource.data)
            || request.resource.data.status in ['active', 'paused', 'sold']));
      allow delete: if admin()
        || (activeUser() && resource.data.ownerId == request.auth.uid);
    }

    match /sellerProfiles/{userId} {
      allow read: if true;
      allow create: if admin()
        || (activeUser()
          && request.auth.uid == userId
          && !('blocked' in request.resource.data));
      allow update: if admin()
        || (activeUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt', 'lastSeenAt']));
      allow delete: if admin();
    }

    match /inquiries/{inquiryId} {
      allow create: if activeUser()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.adId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow read: if admin()
        || (activeUser()
          && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid));
      allow update: if admin()
        || (activeUser()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.adId == resource.data.adId
          && request.resource.data.message == resource.data.message
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reply', 'repliedAt'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() > 0
          && request.resource.data.reply.size() <= 1000);
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if admin()
        || (activeUser() && resource.data.recipientId == request.auth.uid);

      allow create: if admin()
        || (activeUser() && (
          (request.resource.data.type == 'inquiry'
            && request.resource.data.inquiryId is string
            && exists(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId))
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.buyerId == request.auth.uid
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.sellerId == request.resource.data.recipientId)
          ||
          (request.resource.data.type == 'inquiry_reply'
            && request.resource.data.inquiryId is string
            && exists(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId))
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.sellerId == request.auth.uid
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.buyerId == request.resource.data.recipientId
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)).data.reply is string)
          ||
          (request.resource.data.type == 'rating'
            && request.resource.data.ratingId is string
            && exists(/databases/$(database)/documents/sellerRatings/$(request.resource.data.ratingId))
            && get(/databases/$(database)/documents/sellerRatings/$(request.resource.data.ratingId)).data.raterId == request.auth.uid
            && get(/databases/$(database)/documents/sellerRatings/$(request.resource.data.ratingId)).data.sellerId == request.resource.data.recipientId)
        ));

      allow update: if admin()
        || (activeUser()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool);
      allow delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasAll(['adId', 'reporterId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['adId', 'reporterId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.adId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 180
        && request.resource.data.createdAt is number
        && reportId == request.auth.uid + "__" + request.resource.data.adId
        && exists(/databases/$(database)/documents/ads/$(request.resource.data.adId))
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.ownerId != request.auth.uid;
      allow read, delete: if admin();
      allow update: if false;
    }

    match /sellerRatings/{ratingId} {
      allow read: if true;
      allow create: if activeUser()
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if admin()
        || (activeUser()
          && resource.data.raterId == request.auth.uid
          && request.resource.data.raterId == resource.data.raterId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'updatedAt'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5);
      allow delete: if admin();
    }
    
    // User role/profile document: users can read only their own record.
    // Only the verified administrator may create or change role records.
    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if admin();
    }

  }
}