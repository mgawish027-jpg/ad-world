rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function admin() {
      return signedIn()
        && request.auth.token.email == 'mgawish027@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /ads/{adId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if admin() || (signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
    match /sellerProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if admin() || (signedIn() && request.auth.uid == userId);
    }
    match /inquiries/{inquiryId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.adId is string;
      allow read: if admin() || (signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow update: if admin() || (signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','repliedAt']));
      allow delete: if admin();
    }
    match /notifications/{notificationId} {
      allow read: if admin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.recipientId is string;
      allow update: if admin() || (signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if admin();
    }
    match /sellerRatings/{ratingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.raterId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update: if admin() || (signedIn()
        && resource.data.raterId == request.auth.uid
        && request.resource.data.raterId == resource.data.raterId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      allow delete: if admin();
    }
  }
}