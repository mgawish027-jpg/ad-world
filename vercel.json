{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "",
  "buildCommand": "node scripts/deploy-firestore-rules.cjs && echo Static SOUQ site ready",
  "outputDirectory": "souq",
  "headers": [
    {
      "source": "/sw.js",
